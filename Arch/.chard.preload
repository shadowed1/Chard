# <<< CHARD_PRELOAD <
# ChromeOS Only.
# Manual entries.
shopt -s nullglob

LD_PRELOAD_PATTERNS=(
    "$CHARD_ROOT/usr/lib64/libunwind-ptrace.so.0"
    "$CHARD_ROOT/usr/lib64/libunwind-x86_64.so.8"
    "$CHARD_ROOT/usr/lib/libunwind-aarch64.so.8"
    "$CHARD_ROOT/usr/lib64/libunwind.so.8"
    "$CHARD_ROOT/usr/lib64/libmagic.so.1"
    "$CHARD_ROOT/usr/lib64/libseccomp.so.2"
    "$CHARD_ROOT/usr/lib/libunwind-ptrace.so.0"
    "$CHARD_ROOT/usr/lib/libunwind-x86_64.so.8"
    "$CHARD_ROOT/usr/lib/libunwind.so.8"
    "$CHARD_ROOT/usr/lib/libmagic.so.1"
    "$CHARD_ROOT/usr/lib/libseccomp.so.2"
    #"$CHARD_ROOT/usr/lib64/libstdc++.so.6"
    #"$CHARD_ROOT/usr/lib/libstdc++.so.6"
    "$CHARD_ROOT/usr/lib/libpython3.*.so.1.0"
    "$CHARD_ROOT/usr/lib/perl5/*/core_perl/CORE/libperl.so"
    "$CHARD_ROOT/usr/lib/libinotifytools.so.0"
    "$CHARD_ROOT/usr/lib/libbfd-*.so"
    "$CHARD_ROOT/usr/lib/libsframe.so.3"
    "$CHARD_ROOT/usr/lib/libfuse3.so.4"
    "$CHARD_ROOT/usr/lib/libstdc++.so.6"
    "$CHARD_ROOT/usr/lib/libruby.so.*"
    "$CHARD_ROOT/usr/lib/libctf-nobfd.so.0"
    #"$CHARD_ROOT/usr/lib/libdebuginfod.so.1"
    "$CHARD_ROOT/usr/lib/libopcodes-*.so"
    "$CHARD_ROOT/usr/lib/libctf.so.0"
)

LD_PRELOAD=""

for pat in "${LD_PRELOAD_PATTERNS[@]}"; do
    matches=( $pat )
    (( ${#matches[@]} )) || continue
    # pick newest if multiple version matches exist
    lib=$(printf '%s\n' "${matches[@]}" | sort -V | tail -n1)
    [[ -f "$lib" ]] && LD_PRELOAD="${LD_PRELOAD:+$LD_PRELOAD:}$lib"
done

export LD_PRELOAD
# <<< END CHARD_PRELOAD <
