 }
+
+/* Enable open_tree() and move_mount() when the kernel is new enough but
+ * the glibc headers may be older than the running kernel. */
+#ifndef __NR_open_tree
+# if (defined(__x86_64__) && defined(__LP64__)) \
+     || defined(__i386__) \
+     || (defined(__aarch64__) && defined(__LP64__))
+#   define __NR_open_tree 428
+# endif
+#endif
+
+#ifndef __NR_move_mount
+# if (defined(__x86_64__) && defined(__LP64__)) \
+     || defined(__i386__) \
+     || (defined(__aarch64__) && defined(__LP64__))
+#   define __NR_move_mount 429
+# endif
+#endif
+
+#ifndef __NR_fsopen
+# if (defined(__x86_64__) && defined(__LP64__)) \
+     || defined(__i386__) \
+     || (defined(__aarch64__) && defined(__LP64__))
+#   define __NR_fsopen 430
+# endif
+#endif
+
+#ifndef __NR_fsconfig
+# if (defined(__x86_64__) && defined(__LP64__)) \
+     || defined(__i386__) \
+     || (defined(__aarch64__) && defined(__LP64__))
+#   define __NR_fsconfig 431
+# endif
+#endif
+
+#ifndef __NR_fsmount
+# if (defined(__x86_64__) && defined(__LP64__)) \
+     || defined(__i386__) \
+     || (defined(__aarch64__) && defined(__LP64__))
+#   define __NR_fsmount 432
+# endif
+#endif
+
+#ifndef FSOPEN_CLOEXEC
+# define FSOPEN_CLOEXEC 0x00000001
+enum {
+  FSCONFIG_SET_FLAG = 0,
+  FSCONFIG_SET_STRING = 1,
+  FSCONFIG_CMD_CREATE = 6
+};
+# define FSMOUNT_CLOEXEC 0x00000001
+#endif
+
+#ifndef MOVE_MOUNT_F_EMPTY_PATH
+# define MOVE_MOUNT_F_EMPTY_PATH 0x00000004
+#endif
+#ifndef MOVE_MOUNT_T_EMPTY_PATH
+# define MOVE_MOUNT_T_EMPTY_PATH 0x00000040
+#endif
+
+int
+open_tree_wrapper (int dirfd, const char *path, unsigned int flags)
+{
+#ifdef __NR_open_tree
+  return syscall (__NR_open_tree, dirfd, path, flags);
+#else
+  (void) dirfd;
+  (void) path;
+  (void) flags;
+  errno = ENOSYS;
+  return -1;
+#endif
+}
+
+int
+move_mount_wrapper (int from_dirfd, const char *from_path,
+                    int to_dirfd, const char *to_path,
+                    unsigned int flags)
+{
+#ifdef __NR_move_mount
+  return syscall (__NR_move_mount, from_dirfd, from_path, to_dirfd,
+                  to_path, flags);
+#else
+  (void) from_dirfd;
+  (void) from_path;
+  (void) to_dirfd;
+  (void) to_path;
+  (void) flags;
+  errno = ENOSYS;
+  return -1;
+#endif
+}
+
+static int
+fsopen_wrapper (const char *filesystem, unsigned int flags)
+{
+#ifdef __NR_fsopen
+  return syscall (__NR_fsopen, filesystem, flags);
+#else
+  (void) filesystem;
+  (void) flags;
+  errno = ENOSYS;
+  return -1;
+#endif
+}
+
+static int
+fsconfig_wrapper (int fsfd, unsigned int command, const char *key,
+                  const void *value, int aux)
+{
+#ifdef __NR_fsconfig
+  return syscall (__NR_fsconfig, fsfd, command, key, value, aux);
+#else
+  (void) fsfd;
+  (void) command;
+  (void) key;
+  (void) value;
+  (void) aux;
+  errno = ENOSYS;
+  return -1;
+#endif
+}
+
+static int
+fsmount_wrapper (int fsfd, unsigned int flags, unsigned int mount_attr_flags)
+{
+#ifdef __NR_fsmount
+  return syscall (__NR_fsmount, fsfd, flags, mount_attr_flags);
+#else
+  (void) fsfd;
+  (void) flags;
+  (void) mount_attr_flags;
+  errno = ENOSYS;
+  return -1;
+#endif
+}
+
+bool opt_force_fs_mount_fallback = false;
+
+int
+fs_mount_at_fd (const char *filesystem,
+                int dest_fd,
+                unsigned int mount_attr_flags,
+                const fs_mount_option *options,
+                size_t n_options)
+{
+  static bool new_mount_supported = true;
+  unsigned int required_mount_attrs = MOUNT_ATTR_NOSUID | MOUNT_ATTR_NOEXEC;
+  int fsfd = -1;
+  int mount_fd = -1;
+  size_t i;
+
+  /* Keep descriptor-based filesystem mounts restricted to explicit
+   * nosuid/noexec/nodev attributes. devpts is an intentional exception to
+   * NODEV because it provides device nodes for pseudo-terminals. */
+  if (strcmp (filesystem, "devpts") != 0)
+    required_mount_attrs |= MOUNT_ATTR_NODEV;
+
+  if ((mount_attr_flags & required_mount_attrs) != required_mount_attrs)
+    {
+      errno = EPERM;
+      return -1;
+    }
+
+  if (opt_force_fs_mount_fallback || !new_mount_supported)
+    {
+      errno = ENOSYS;
+      return -1;
+    }
+
+  debug ("Using fsopen() and move_mount() for %s mount", filesystem);
+
+  fsfd = fsopen_wrapper (filesystem, FSOPEN_CLOEXEC);
+  if (fsfd < 0)
+    goto failed;
+
+  for (i = 0; i < n_options; i++)
+    {
+      unsigned int command = options[i].value != NULL
+                             ? FSCONFIG_SET_STRING
+                             : FSCONFIG_SET_FLAG;
+
+      if (fsconfig_wrapper (fsfd, command, options[i].key,
+                            options[i].value, 0) < 0)
+        goto failed;
+    }
+
+  if (fsconfig_wrapper (fsfd, FSCONFIG_CMD_CREATE, NULL, NULL, 0) < 0)
+    goto failed;
+
+  mount_fd = fsmount_wrapper (fsfd, FSMOUNT_CLOEXEC, mount_attr_flags);
+  if (mount_fd < 0)
+    goto failed;
+
+  if (move_mount_wrapper (mount_fd, "", dest_fd, "",
+                          MOVE_MOUNT_F_EMPTY_PATH |
+                          MOVE_MOUNT_T_EMPTY_PATH) < 0)
+    goto failed;
+
+  close (mount_fd);
+  close (fsfd);
+  debug ("-> Success");
+  return 0;
+
+failed:
+  {
+    int saved_errno = errno;
+
+    if (mount_fd >= 0)
+      close (mount_fd);
+    if (fsfd >= 0)
+      close (fsfd);
+
+    if (saved_errno == ENOSYS)
+      {
+        new_mount_supported = false;
+        debug ("New filesystem mount API is unavailable; falling back to mount()");
+      }
+
+    errno = saved_errno;
+    return -1;
+  }
+}
