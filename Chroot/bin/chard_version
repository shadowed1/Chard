    echo "- Updated Chard Gentoo to use Python 3.14 and LLVM 23."
    echo "- Updated .chard.preload for Chard Arch."
    echo "- Fixed crackling audio and audio artifacts, especially when recording/streaming - thanks to LolWRLD for fixing and reporting Chardwire gamma bug."
    echo "- Fixed Chard Gentoo from not installing Bubblepatch, Flatpatch, Chardonnay, and others."
